# Supabase (separate project for this prototype). Only the server uses these.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google service account (Sheets API enabled). Paste private_key from the JSON key, in quotes, with \n escapes.
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
